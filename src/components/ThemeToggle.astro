---
// Control de tema con nombre accesible y estado (RF-4).
// El estado y el texto los sincroniza app.ts; aquí se fija el estado por defecto (oscuro).
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-pressed="true"
  aria-label="Tema oscuro activo. Cambiar a tema claro."
>
  <svg
    class="theme-toggle__icon theme-toggle__icon--moon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
  <svg
    class="theme-toggle__icon theme-toggle__icon--sun"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <span class="theme-toggle__text">Oscuro</span>
</button>
