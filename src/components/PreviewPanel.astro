<section class="preview-panel" aria-label="Vista previa">
  <header class="preview-panel__header no-print">
    <h2 class="preview-panel__title">Vista previa</h2>
    <button id="export" class="preview-panel__export" type="button" disabled>Exportar a PDF</button>
  </header>
  <div class="preview-panel__body">
    <article id="preview" class="paper"></article>
    <p id="preview-empty" class="preview-panel__empty no-print" hidden>
      No hay contenido que mostrar. Escribe o pega Markdown en el editor.
    </p>
  </div>
</section>
